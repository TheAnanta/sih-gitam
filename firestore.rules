rules_version = '2';

// NOTE: this Firebase project (sih-connect) is shared with another app (the
// "SIH Team Formation Platform" — uses the `users`, `analytics_events`, and
// `conversations` collections with its own schema). Before SIH Navigator
// started writing here, every collection was fully open (no rules). To avoid
// breaking that app, we only lock down collections that are unambiguously
// ours (namespaced with an `sih_nav_` prefix, plus `lists`, which the other
// app doesn't use); everything else keeps its original wide-open behavior.

service cloud.firestore {
  match /databases/{database}/documents {
    // True for a signed-in user who is NOT the anonymous identity we give
    // every visitor by default (see src/hooks/use-auth.ts) — i.e. someone
    // who actually signed in with Google.
    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Shared lists ("albums"): anyone can read (so links work for logged-out
    // visitors, including our own anonymously-authenticated ones), but only
    // a *real* signed-in user (not the anonymous identity every visitor gets
    // by default) can create a list, edit it, or add/remove items.
    match /lists/{listId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isRealUser();
      allow delete: if isRealUser()
        && resource.data.ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read: if true;
        allow write: if isRealUser();
      }
    }

    // SIH Navigator's own behavioral analytics, namespaced to avoid the
    // collision with the other app's pre-existing `analytics_events`
    // collection. Write-only from the client; dashboards read this locally
    // via the user's own gcloud credentials, not from the browser.
    match /sih_nav_analytics_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Everything else (users/, analytics_events/, conversations/, and
    // anything else the other app uses, including SIH Navigator's own
    // bookmark data at users/{uid}.bookmarks, which now cohabits that
    // collection) keeps the fully-open behavior this project had before we
    // touched it.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
